generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id                 String   @id @default(cuid())
  name               String
  defaultLanguage    String   @default("en") @map("default_language")
  timezone           String   @default("Europe/Bucharest")
  telegramChatId     String?  @map("telegram_chat_id")
  apiKeyHash         String   @unique @map("api_key_hash")
  monthlySpendCapUsd Decimal? @map("monthly_spend_cap_usd") @db.Decimal(10, 2)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("businesses")
}

model Product {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  name       String
  slug       String   @unique
  settings   Json
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  knowledgeSections KnowledgeSection[]
  recommendations   Recommendation[]
  posts             Post[]
  learnings         Learning[]
  agentRuns         AgentRun[]

  @@index([businessId])
  @@map("products")
}

enum KnowledgeKind {
  PRODUCT
  AUDIENCE
  TONE
  EXAMPLES
}

model KnowledgeSection {
  id        String        @id @default(cuid())
  productId String        @map("product_id")
  kind      KnowledgeKind
  title     String
  content   String
  sortOrder Int           @default(0) @map("sort_order")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, kind])
  @@index([productId])
  @@map("knowledge_sections")
}

enum ContentType {
  EDUCATIONAL
  FEATURE
  SOCIAL_PROOF
  OFFER
}

enum RecommendationStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  USED
}

model Recommendation {
  id          String               @id @default(cuid())
  productId   String               @map("product_id")
  topic       String
  angle       String
  contentType ContentType          @map("content_type")
  rationale   String
  status      RecommendationStatus @default(PROPOSED)
  weekOf      DateTime             @map("week_of") @db.Date
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  posts   Post[]

  @@index([productId, weekOf])
  @@map("recommendations")
}

enum Platform {
  FACEBOOK
  INSTAGRAM
}

enum PostStatus {
  PENDING_APPROVAL
  APPROVED
  SKIPPED
  POSTED
}

model Post {
  id               String     @id @default(cuid())
  productId        String     @map("product_id")
  recommendationId String?    @map("recommendation_id")
  platform         Platform
  content          String
  editedContent    String?    @map("edited_content")
  status           PostStatus @default(PENDING_APPROVAL)
  scheduledFor     DateTime?  @map("scheduled_for")
  generationMeta   Json       @default("{}") @map("generation_meta")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  product        Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  recommendation Recommendation?  @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  signals        FeedbackSignal[]

  @@index([productId, status])
  @@index([productId, scheduledFor])
  @@map("posts")
}

enum SignalType {
  APPROVED
  EDITED
  SKIPPED
  PERFORMANCE
}

model FeedbackSignal {
  id        String     @id @default(cuid())
  postId    String     @map("post_id")
  type      SignalType
  payload   Json       @default("{}")
  createdAt DateTime   @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("feedback_signals")
}

enum LearningCategory {
  TONE
  TOPIC
  FORMAT
  TIMING
}

enum LearningStatus {
  ACTIVE
  ARCHIVED
}

model Learning {
  id              String           @id @default(cuid())
  productId       String           @map("product_id")
  category        LearningCategory
  content         String
  sourceSignalIds String[]         @default([]) @map("source_signal_ids")
  status          LearningStatus   @default(ACTIVE)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, status])
  @@map("learnings")
}

enum AgentTask {
  GENERATE
  RECOMMEND
  REGENERATE
  DISTILL
}

enum RunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model AgentRun {
  id           String    @id @default(cuid())
  productId    String    @map("product_id")
  task         AgentTask
  model        String
  inputTokens  Int       @default(0) @map("input_tokens")
  outputTokens Int       @default(0) @map("output_tokens")
  costUsd      Decimal   @default(0) @map("cost_usd") @db.Decimal(10, 6)
  status       RunStatus @default(RUNNING)
  error        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  finishedAt   DateTime? @map("finished_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@map("agent_runs")
}
