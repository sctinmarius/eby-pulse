# --- Server ---
NODE_ENV=development
PORT=3333

# --- Database (docker-compose maps postgres to 5433) ---
DATABASE_URL=postgresql://ebypulse:ebypulse@localhost:5433/ebypulse

# --- Auth ---
# Protects POST /businesses (tenant creation). Generate: openssl rand -hex 24
BOOTSTRAP_TOKEN=

# --- LLM ---
ANTHROPIC_API_KEY=

# --- Telegram (unused until Phase 4; validated lazily) ---
TELEGRAM_BOT_TOKEN=

# --- Per-task models (format providerId:modelId) ---
MODEL_GENERATE=anthropic:claude-sonnet-4-5
MODEL_RECOMMEND=anthropic:claude-sonnet-4-5
MODEL_REGENERATE=anthropic:claude-sonnet-4-5
MODEL_DISTILL=anthropic:claude-haiku-4-5
